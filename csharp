using UnityEngine;
using UnityEngine.UI;

public class PlayerController : MonoBehaviour
{
    [Header("Stats")]
    public int maxHealth = 5;
    public int currentHealth;
    public int score = 0;
    public int level = 1;

    [Header("UI")]
    public Text scoreText;
    public Text healthText;
    public Text levelText;

    [Header("Shooting")]
    public GameObject bulletPrefab;
    public Transform firePoint;
    public float fireRate = 0.15f;
    private float nextFireTime = 0f;

    [Header("Crosshair (Horror Style)")]
    public Texture2D crosshairTexture; // Bisa diisi foto, atau biarkan kosong untuk default horror
    public float crosshairSize = 50f;

    void Start()
    {
        currentHealth = maxHealth;
        UpdateUI();
        Cursor.visible = false;
    }

    void Update()
    {
        // Gerakan mengikuti mouse
        Vector3 mousePos = Camera.main.ScreenToWorldPoint(Input.mousePosition);
        mousePos.z = 0;
        transform.position = mousePos;

        // Tembak
        if (Input.GetMouseButton(0) && Time.time >= nextFireTime)
        {
            nextFireTime = Time.time + fireRate;
            Shoot();
        }
    }

    void Shoot()
    {
        Instantiate(bulletPrefab, firePoint.position, Quaternion.identity);
    }

    // ===== CROSSHAIR HORROR =====
    void OnGUI()
    {
        Vector3 mousePos = Input.mousePosition;
        float x = mousePos.x;
        float y = Screen.height - mousePos.y;

        if (crosshairTexture != null)
        {
            // Pakai foto custom
            float cx = x - crosshairSize / 2;
            float cy = y - crosshairSize / 2;
            GUI.DrawTexture(new Rect(cx, cy, crosshairSize, crosshairSize), crosshairTexture);
        }
        else
        {
            // Default crosshair horror: lingkaran + salib merah
            GUI.color = new Color(1f, 0.2f, 0.1f, 0.9f);
            
            // Lingkaran luar
            float radius = 18f;
            int segments = 20;
            Vector3 center = new Vector3(x, y, 0);
            for (int i = 0; i < segments; i++)
            {
                float ang1 = (i / (float)segments) * 2 * Mathf.PI;
                float ang2 = ((i + 1) / (float)segments) * 2 * Mathf.PI;
                Vector3 p1 = center + new Vector3(Mathf.Cos(ang1), Mathf.Sin(ang1), 0) * radius;
                Vector3 p2 = center + new Vector3(Mathf.Cos(ang2), Mathf.Sin(ang2), 0) * radius;
                DrawLine(p1, p2, Color.red, 2f);
            }

            // Salib
            DrawLine(new Vector3(x - 25, y, 0), new Vector3(x + 25, y, 0), Color.red, 2f);
            DrawLine(new Vector3(x, y - 25, 0), new Vector3(x, y + 25, 0), Color.red, 2f);

            // Titik tengah
            GUI.color = Color.white;
            GUI.DrawTexture(new Rect(x - 3, y - 3, 6, 6), Texture2D.whiteTexture);
            
            // Simbol horror di sudut
            GUI.color = new Color(1f, 0.3f, 0.1f, 0.3f);
            GUI.Label(new Rect(x + 20, y - 30, 40, 30), "☠️");
            GUI.Label(new Rect(x - 50, y + 10, 40, 30), "☠️");
            GUI.color = Color.white;
        }
    }

    void DrawLine(Vector3 start, Vector3 end, Color color, float width)
    {
        Vector3 diff = end - start;
        float angle = Mathf.Atan2(diff.y, diff.x) * Mathf.Rad2Deg;
        float length = diff.magnitude;
        GUIUtility.RotateAroundPivot(angle, start);
        GUI.color = color;
        GUI.DrawTexture(new Rect(start.x, start.y - width/2, length, width), Texture2D.whiteTexture);
        GUI.color = Color.white;
        GUIUtility.RotateAroundPivot(0, start);
    }

    // ===== DAMAGE & SCORE =====
    public void TakeDamage(int damage)
    {
        currentHealth -= damage;
        if (currentHealth <= 0) { currentHealth = 0; Time.timeScale = 0; }
        UpdateUI();
    }

    public void AddScore(int points)
    {
        score += points;
        int newLevel = Mathf.FloorToInt(score / 10) + 1;
        if (newLevel > level) { level = newLevel; }
        UpdateUI();
    }

    void UpdateUI()
    {
        scoreText.text = "Score: " + score;
        healthText.text = "Health: " + currentHealth;
        levelText.text = "Level: " + level;
    }
}
